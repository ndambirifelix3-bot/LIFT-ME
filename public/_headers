# Response headers for Cloudflare (same rules as netlify.toml).
# wrangler.jsonc serves index.html for any address that isn't a real file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()

# The service worker and the main page must never be cached, or phones would miss app updates.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# App code, fonts and images have a content hash in their file names: cache them for a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json

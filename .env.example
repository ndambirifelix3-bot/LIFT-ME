# Copy to .env and fill in. .env is git-ignored. Only PUBLIC values belong in the app.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Where the web version is hosted (used for "share my trip" links), e.g. https://liftme.example.com
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Google Maps SDK keys for the phone apps (restricted to package com.liftme.app / bundle id)
# Used only when making a development/production build with EAS.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Filled in by `npx eas-cli init`
EAS_PROJECT_ID=

# NEVER put these here — they are Supabase Edge Function secrets (see docs/SETUP.md):
# SUPABASE_SERVICE_ROLE_KEY, GOOGLE_MAPS_SERVER_KEY, MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET,
# MPESA_PASSKEY, MPESA_SHORTCODE, MPESA_CALLBACK_SECRET
